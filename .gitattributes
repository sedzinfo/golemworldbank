# Files stored in Git LFS (GitHub rejects normal files over 100 MB).
# A rule only applies to files added AFTER it exists: a file already committed
# as a normal file has to be removed from the index (git rm --cached) and added again.

# package data
data/*.rda filter=lfs diff=lfs merge=lfs -text
data/*.csv filter=lfs diff=lfs merge=lfs -text
data/*.zip filter=lfs diff=lfs merge=lfs -text

# raw World Bank downloads
data-raw/*.rda filter=lfs diff=lfs merge=lfs -text
data-raw/*.csv filter=lfs diff=lfs merge=lfs -text
data-raw/*.zip filter=lfs diff=lfs merge=lfs -text

# built package
*.tar.gz filter=lfs diff=lfs merge=lfs -text
